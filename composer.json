{
    "name": "vzgcoders/discordphp-bridge",
    "description": "The platform-agnostic half of a Discord chat bridge: routing, persistence, one command catalogue served to every chat, and Components v2 panels. Platforms plug in as connectors.",
    "keywords": [
        "discord",
        "chat",
        "relay",
        "bridge",
        "bot",
        "reactphp",
        "async"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Valithor Obsidion",
            "email": "valithor@valgorithms.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "discord-php/http": "dev-master as 10.1.7",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "react/event-loop": "^1.5",
        "react/filesystem": "^0.2@dev",
        "react/promise": "^3.2",
        "team-reflex/discord-php": "dev-master"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpunit/phpunit": "^11.0 || ^10.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../DiscordPHP",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../DiscordPHP-Http",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Bridge\\": "src/Bridge/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bridge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
